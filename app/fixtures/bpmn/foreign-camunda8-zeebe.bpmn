    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="Release planned">
      <bpmn:outgoing>Flow_0a1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:subProcess id="Activity_spec" name="Specification">
      <bpmn:incoming>Flow_0a1</bpmn:incoming>
      <bpmn:outgoing>Flow_0a2</bpmn:outgoing>
      <bpmn:startEvent id="Event_spec_start">
        <bpmn:outgoing>Flow_s1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="Activity_srs" name="Requirements spec (SRS)">
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:assignmentDefinition candidateGroups="analysts" />
          <zeebe:formDefinition formKey="camunda-forms:bpmn:UserTaskForm_1x0f4cq" />
          <zeebe:taskHeaders>
            <zeebe:header key="sla" value="P5D" />
          </zeebe:taskHeaders>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_s1</bpmn:incoming>
        <bpmn:outgoing>Flow_s2</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="Event_spec_end">
        <bpmn:incoming>Flow_s2</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_s1" sourceRef="Event_spec_start" targetRef="Activity_srs" />
      <bpmn:sequenceFlow id="Flow_s2" sourceRef="Activity_srs" targetRef="Event_spec_end" />
    </bpmn:subProcess>
    <bpmn:callActivity id="Activity_0secrev" name="Security review">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="security-review" propagateAllChildVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=releaseId" target="releaseId" />
          <zeebe:output source="=findings" target="securityFindings" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0a2</bpmn:incoming>
      <bpmn:outgoing>Flow_0a3</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:boundaryEvent id="Event_1sla0br" name="5 days" cancelActivity="false" attachedToRef="Activity_0secrev">
      <bpmn:outgoing>Flow_0sla</bpmn:outgoing>
