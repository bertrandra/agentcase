  <bpmn:process id="Process_release_train" name="Release train" isExecutable="true">
    <bpmn:extensionElements>
      <zeebe:userTaskForm id="UserTaskForm_1x0f4cq">{ "components": [ { "key": "approved", "type": "checkbox", "label": "Approved" } ] }</zeebe:userTaskForm>
