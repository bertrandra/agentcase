    </bpmn:intermediateCatchEvent>
    <bpmn:subProcess id="Activity_hypercare" name="Hypercare">
      <bpmn:incoming>Flow_0a4</bpmn:incoming>
      <bpmn:outgoing>Flow_0a5</bpmn:outgoing>
      <bpmn:startEvent id="Event_hc_start">
        <bpmn:outgoing>Flow_h1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="Activity_monitor" name="Monitor error rates">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="monitor-errors" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_h1</bpmn:incoming>
        <bpmn:outgoing>Flow_h2</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="Event_hc_end">
        <bpmn:incoming>Flow_h2</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_h1" sourceRef="Event_hc_start" targetRef="Activity_monitor" />
      <bpmn:sequenceFlow id="Flow_h2" sourceRef="Activity_monitor" targetRef="Event_hc_end" />
    </bpmn:subProcess>
    <bpmn:endEvent id="Event_0done" name="Released">
      <bpmn:incoming>Flow_0a5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0a1" sourceRef="StartEvent_1" targetRef="Activity_spec" />
