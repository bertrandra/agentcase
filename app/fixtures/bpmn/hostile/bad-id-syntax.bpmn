<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="defs-bad-id" targetNamespace="https://example.org/hostile">
  <bpmn:process id="proc" isExecutable="false">
