<?xml version="1.0" encoding="UTF-8"?>
<!-- Schema-valid BPMN whose names and documentation hold markup: F-B10 neutralises it (text only, never rendered as HTML); the validator flags it. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="defs-html" targetNamespace="https://example.org/hostile">
  <bpmn:process id="proc" name="&lt;img src=x onerror=alert(1)&gt;" isExecutable="false">
    <bpmn:task id="task-1" name="&lt;script&gt;alert('name')&lt;/script&gt;">
      <bpmn:documentation>&lt;iframe src="javascript:alert(1)"&gt;&lt;/iframe&gt;</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="task-2" name="Effort &lt; 5 days &amp; no markup">
      <bpmn:documentation><![CDATA[<svg onload=alert(2)></svg>]]></bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="task-3" name="&#60;b&#62;bold&#60;/b&#62;"/>
  </bpmn:process>
</bpmn:definitions>
