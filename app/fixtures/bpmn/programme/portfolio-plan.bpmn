<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:ac="https://agentcase.app/schema/bpmn/1.0" id="PortfolioPlanSample" targetNamespace="https://agentcase.app/portfolio" exporter="AgentCase"><bpmn:process id="PortfolioPlan" name="Portfolio plan" isExecutable="false"><bpmn:laneSet id="PortfolioPlan_lanes" ac:setupCapacity="2"><bpmn:lane id="PortfolioPlan_team" name="Transformation team"><bpmn:flowNodeRef>wave_w1</bpmn:flowNodeRef><bpmn:flowNodeRef>wave_wdr3dpo</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:subProcess id="wave_w1" name="Wave 1"><bpmn:extensionElements><ac:wave code="w1" startMonth="0"/></bpmn:extensionElements><bpmn:callActivity id="pm_p1" name="Product 1"><bpmn:extensionElements><ac:knowledgeSubset product="p1"/></bpmn:extensionElements></bpmn:callActivity><bpmn:callActivity id="pm_pq5uoye" name="Payroll"><bpmn:extensionElements><ac:knowledgeSubset product="pq5uoye" maturityAnswers="1 1 2 1 2 2 1 1 2" targetCC="2" curationFTE="1" setupBase="90000"><ac:domain label="Documentation" weightPct="40"/><ac:domain label="Code" weightPct="60"/></ac:knowledgeSubset></bpmn:extensionElements></bpmn:callActivity></bpmn:subProcess><bpmn:subProcess id="wave_wdr3dpo" name="Wave 2"><bpmn:extensionElements><ac:wave code="wdr3dpo" startMonth="6" note="after the first wave" after="w1" milestone="setupEnd" lag="1"/></bpmn:extensionElements><bpmn:callActivity id="pm_p299ec9" name="Billing"><bpmn:extensionElements><ac:knowledgeSubset product="p299ec9" targetCC="4" ktLeadMonths="3"><ac:domain label="Operating procedures" weightPct="100"/></ac:knowledgeSubset></bpmn:extensionElements></bpmn:callActivity></bpmn:subProcess><bpmn:callActivity id="pm_prp40uj" name="Archive (no wave)"><bpmn:extensionElements><ac:knowledgeSubset product="prp40uj"/></bpmn:extensionElements></bpmn:callActivity><bpmn:sequenceFlow id="dep_wdr3dpo" sourceRef="wave_w1" targetRef="wave_wdr3dpo"/></bpmn:process></bpmn:definitions>
