<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:ac="https://agentcase.app/schema/bpmn/1.0" id="prog-Definitions" targetNamespace="https://agentcase.app/process">
  <bpmn:collaboration id="prog-Collaboration">
    <bpmn:participant id="prog-Participant" name="Transformation programme" processRef="prog-Process" ac:programme="true"/>
    <bpmn:participant id="Participant" name="Delivery process"/>
    <bpmn:messageFlow id="prog-mf-agents" name="Hub ready → agents enabled" sourceRef="prog-hubSetup" targetRef="Participant"/>
    <bpmn:messageFlow id="prog-mf-wave" name="Knowledge transfer done → the product's wave starts" sourceRef="prog-ktPrep" targetRef="Participant"/>
    <bpmn:messageFlow id="prog-mf-scale" name="Pilot decision → scale" sourceRef="prog-stage-decide" targetRef="Participant"/>
  </bpmn:collaboration>
  <bpmn:process id="prog-Process" name="Transformation programme" isExecutable="false" processType="None" ac:programme="true">
    <bpmn:laneSet id="prog-LaneSet" ac:setupCapacity="2">
      <bpmn:lane id="prog-lane-aiOffice" name="AI Office lead">
        <bpmn:flowNodeRef>prog-stage-discover</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prog-stage-calibrate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prog-stage-validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prog-change</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prog-riskAiAct</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="prog-lane-designAuthority" name="Design Authority">
        <bpmn:flowNodeRef>prog-stage-decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prog-setupGovernance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prog-govGates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prog-gate-L2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prog-gate-L3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prog-gate-L4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="prog-lane-orchestrator" name="Orchestrator">
        <bpmn:flowNodeRef>prog-stage-pilotProve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prog-pilot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prog-build</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prog-agentops</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="prog-lane-aiReviewer" name="AI reviewer">
        <bpmn:flowNodeRef>prog-hubRun</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prog-auditInterviews</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="prog-lane-preceptor" name="Preceptor">
        <bpmn:flowNodeRef>prog-setupTraining</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prog-setupCoaching</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prog-ktPrep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prog-capabilityTarget</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="prog-lane-agentArchitect" name="Agent architect">
        <bpmn:flowNodeRef>prog-setupTooling</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prog-hubSetup</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="prog-lane-finops" name="FinOps">
        <bpmn:flowNodeRef>prog-valueTracking</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="prog-lane-agents" name="AI agents">
        <bpmn:flowNodeRef>prog-run</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:subProcess id="prog-phase-engagement" name="Engagement stages">
      <bpmn:task id="prog-stage-discover" name="Discover">
        <bpmn:documentation>Framing, AS-IS baseline, eligibility. Exit gate: Baseline validated + eligibility.</bpmn:documentation>
        <bpmn:extensionElements>
          <ac:programmeActivity kind="stage-discover" level="case" costRule="optIn" timing="stage" placement="4 weeks from week 0 after the case start">
            <ac:param key="rmD1" value="4" unit="weeks"/>
          </ac:programmeActivity>
          <ac:raci responsible="prog-lane-aiOffice" accountable="prog-lane-designAuthority" consulted="prog-lane-finops" informed="prog-lane-orchestrator"/>
        </bpmn:extensionElements>
      </bpmn:task>
      <bpmn:task id="prog-stage-calibrate" name="Calibrate">
        <bpmn:documentation>Sector coefficients, artifact scope frozen. Exit gate: Scope &amp; coefficients frozen.</bpmn:documentation>
        <bpmn:extensionElements>
          <ac:programmeActivity kind="stage-calibrate" level="case" costRule="optIn" timing="stage" placement="4 weeks from week 4 after the case start">
            <ac:param key="rmD2" value="4" unit="weeks"/>
          </ac:programmeActivity>
          <ac:raci responsible="prog-lane-aiOffice" accountable="prog-lane-designAuthority" consulted="prog-lane-finops" informed="prog-lane-orchestrator"/>
        </bpmn:extensionElements>
      </bpmn:task>
      <bpmn:task id="prog-stage-validate" name="Validate">
        <bpmn:documentation>Assumptions signed, Monte Carlo run. Exit gate: Assumptions register signed · P50 &gt; threshold.</bpmn:documentation>
        <bpmn:extensionElements>
          <ac:programmeActivity kind="stage-validate" level="case" costRule="optIn" timing="stage" placement="4 weeks from week 8 after the case start">
            <ac:param key="rmD3" value="4" unit="weeks"/>
          </ac:programmeActivity>
          <ac:raci responsible="prog-lane-aiOffice" accountable="prog-lane-designAuthority" consulted="prog-lane-finops" informed="prog-lane-orchestrator"/>
        </bpmn:extensionElements>
      </bpmn:task>
      <bpmn:task id="prog-stage-pilotProve" name="Pilot &amp; Prove">
        <bpmn:documentation>Pilot pods, KPI tracking. Exit gate: Pilot KPIs ≥ 80% of Y1 targets.</bpmn:documentation>
        <bpmn:extensionElements>
          <ac:programmeActivity kind="stage-pilotProve" level="case" costRule="optIn" timing="stage" placement="6 weeks from week 12 after the case start">
            <ac:param key="rmD4" value="6" unit="weeks"/>
          </ac:programmeActivity>
          <ac:raci responsible="prog-lane-orchestrator" accountable="prog-lane-designAuthority" consulted="prog-lane-finops" informed="prog-lane-orchestrator"/>
        </bpmn:extensionElements>
      </bpmn:task>
      <bpmn:task id="prog-stage-decide" name="Decide &amp; Scale">
        <bpmn:documentation>Scale-out per Decision Intelligence. Exit gate: Verdict ≥ Conditional GO.</bpmn:documentation>
        <bpmn:extensionElements>
          <ac:programmeActivity kind="stage-decide" level="case" costRule="none" timing="gate" placement="Gate at week 18 after the case start, when Pilot &amp; Prove ends"/>
          <ac:raci responsible="prog-lane-designAuthority" accountable="prog-lane-aiOffice" consulted="prog-lane-finops" informed="prog-lane-orchestrator"/>
        </bpmn:extensionElements>
      </bpmn:task>
    </bpmn:subProcess>
    <bpmn:subProcess id="prog-phase-setup" name="Setup (per product)">
      <bpmn:task id="prog-pilot" name="Pilot">
        <bpmn:documentation>A pilot pod proves the agentic factory (frozen harness + agents) by demonstration: break-in sprints to stabilise the harness, then prove weeks on 3-day fail-fast iterations.</bpmn:documentation>
        <bpmn:extensionElements>
          <ac:programmeActivity kind="pilot" level="product" costRule="resources" timing="pilot" placement="16 weeks (12 prove + 2 × 2 break-in); the cost model spends it from the product's month 1; the Gantt shows it as the Pilot &amp; Prove stage" cost="84886.15">
            <ac:param key="pilotFte" value="3" unit="FTE"/>
            <ac:param key="pilotBreakin" value="2" unit="sprints"/>
            <ac:param key="pilotWeeks" value="12" unit="weeks"/>
          </ac:programmeActivity>
          <ac:raci responsible="prog-lane-orchestrator" accountable="prog-lane-designAuthority" consulted="prog-lane-preceptor" informed="prog-lane-finops"/>
        </bpmn:extensionElements>
        <bpmn:multiInstanceLoopCharacteristics isSequential="false">
          <bpmn:loopCardinality>3</bpmn:loopCardinality>
        </bpmn:multiInstanceLoopCharacteristics>
      </bpmn:task>
      <bpmn:task id="prog-setupTooling" name="Setup: tooling and infrastructure">
        <bpmn:documentation>Claude API, monitoring, security, CI/CD.</bpmn:documentation>
        <bpmn:extensionElements>
          <ac:programmeActivity kind="setupTooling" level="product" costRule="nonLabour" timing="setup" placement="The engine spends it evenly over the product's months 1–6 (the setup profile)" cost="35000">
            <ac:param key="setupTooling" value="35000" unit="€"/>
          </ac:programmeActivity>
          <ac:raci responsible="prog-lane-agentArchitect" accountable="prog-lane-designAuthority" consulted="prog-lane-finops"/>
        </bpmn:extensionElements>
        <bpmn:multiInstanceLoopCharacteristics isSequential="false">
          <bpmn:loopCardinality>3</bpmn:loopCardinality>
        </bpmn:multiInstanceLoopCharacteristics>
      </bpmn:task>
      <bpmn:task id="prog-setupTraining" name="Setup: training">
        <bpmn:documentation>Workshops, champion certification; it builds the capability of the organisation: the people in training are its trainees, up to the target mass.</bpmn:documentation>
        <bpmn:extensionElements>
          <ac:programmeActivity kind="setupTraining" level="product" costRule="resources" timing="setup" placement="The engine spends it evenly over the product's months 1–6 (the setup profile)" cost="45000">
            <ac:param key="setupTraining" value="45000" unit="€"/>
            <ac:param key="capOps" value="50" unit="people"/>
            <ac:param key="capTrain" value="200" unit="people"/>
            <ac:param key="capTarget" value="500" unit="people"/>
          </ac:programmeActivity>
          <ac:raci responsible="prog-lane-preceptor" accountable="prog-lane-aiOffice" informed="prog-lane-orchestrator"/>
        </bpmn:extensionElements>
        <bpmn:multiInstanceLoopCharacteristics isSequential="false">
          <bpmn:loopCardinality>3</bpmn:loopCardinality>
        </bpmn:multiInstanceLoopCharacteristics>
      </bpmn:task>
      <bpmn:task id="prog-setupCoaching" name="Setup: coaching">
        <bpmn:documentation>Pair programming, deliverable review; the coaching load weans from Y1 to cruise.</bpmn:documentation>
        <bpmn:extensionElements>
          <ac:programmeActivity kind="setupCoaching" level="product" costRule="resources" timing="setup" placement="The engine spends it evenly over the product's months 1–6 (the setup profile)" cost="35000">
            <ac:param key="setupCoaching" value="35000" unit="€"/>
            <ac:param key="coachY1" value="40" unit="%"/>
            <ac:param key="coachCruise" value="20" unit="%"/>
          </ac:programmeActivity>
          <ac:raci responsible="prog-lane-preceptor" accountable="prog-lane-aiOffice" consulted="prog-lane-orchestrator"/>
        </bpmn:extensionElements>
        <bpmn:multiInstanceLoopCharacteristics isSequential="false">
          <bpmn:loopCardinality>3</bpmn:loopCardinality>
        </bpmn:multiInstanceLoopCharacteristics>
      </bpmn:task>
      <bpmn:task id="prog-setupGovernance" name="Setup: governance">
        <bpmn:documentation>Compliance audit, IP, agentic charter.</bpmn:documentation>
        <bpmn:extensionElements>
          <ac:programmeActivity kind="setupGovernance" level="product" costRule="resources" timing="setup" placement="The engine spends it evenly over the product's months 1–6 (the setup profile)" cost="20000">
            <ac:param key="setupGov" value="20000" unit="€"/>
          </ac:programmeActivity>
          <ac:raci responsible="prog-lane-designAuthority" accountable="prog-lane-aiOffice" informed="prog-lane-finops"/>
        </bpmn:extensionElements>
        <bpmn:multiInstanceLoopCharacteristics isSequential="false">
          <bpmn:loopCardinality>3</bpmn:loopCardinality>
        </bpmn:multiInstanceLoopCharacteristics>
      </bpmn:task>
      <bpmn:task id="prog-change" name="Change management (readiness)">
        <bpmn:documentation>Entry headcount × cost per FTE of the human-readiness intensity (HRI).</bpmn:documentation>
        <bpmn:extensionElements>
          <ac:programmeActivity kind="change" level="product" costRule="engine" timing="setup" placement="The engine spends it evenly over the product's months 1–6 (the setup profile)" cost="0" active="false"/>
          <ac:raci responsible="prog-lane-aiOffice" accountable="prog-lane-aiOffice" consulted="prog-lane-preceptor"/>
        </bpmn:extensionElements>
        <bpmn:multiInstanceLoopCharacteristics isSequential="false">
          <bpmn:loopCardinality>3</bpmn:loopCardinality>
        </bpmn:multiInstanceLoopCharacteristics>
      </bpmn:task>
      <bpmn:task id="prog-hubSetup" name="Knowledge Hub setup">
        <bpmn:documentation>Ingest, index and guardrails: the hub setup base × the context-completeness gap to close.</bpmn:documentation>
        <bpmn:extensionElements>
          <ac:programmeActivity kind="hubSetup" level="product" costRule="resources" timing="hubSetup" placement="Gantt: 30 days after the onboarding stages; engine: inside the 6-month setup profile; consolidation: 0 months before the product's month 0" cost="90000">
            <ac:param key="khTargetCC" value="3" unit="level"/>
            <ac:param key="khSetupBase" value="120000" unit="€"/>
            <ac:param key="khSetupDays" value="30" unit="days"/>
          </ac:programmeActivity>
          <ac:raci responsible="prog-lane-agentArchitect" accountable="prog-lane-designAuthority" consulted="prog-lane-aiReviewer"/>
        </bpmn:extensionElements>
        <bpmn:multiInstanceLoopCharacteristics isSequential="false">
          <bpmn:loopCardinality>3</bpmn:loopCardinality>
        </bpmn:multiInstanceLoopCharacteristics>
      </bpmn:task>
      <bpmn:task id="prog-ktPrep" name="Knowledge transfer preparation">
        <bpmn:documentation>The product's knowledge transfer prepared before its wave starts.</bpmn:documentation>
        <bpmn:extensionElements>
          <ac:programmeActivity kind="ktPrep" level="product" costRule="sameAsHubSetup" timing="ktPrep" placement="0 months before the product's month 0" cost="90000">
            <ac:param key="ktLeadMonths" value="0" unit="months"/>
          </ac:programmeActivity>
          <ac:raci responsible="prog-lane-preceptor" accountable="prog-lane-aiOffice" consulted="prog-lane-aiReviewer"/>
        </bpmn:extensionElements>
        <bpmn:multiInstanceLoopCharacteristics isSequential="false">
          <bpmn:loopCardinality>3</bpmn:loopCardinality>
        </bpmn:multiInstanceLoopCharacteristics>
      </bpmn:task>
      <bpmn:intermediateThrowEvent id="prog-capabilityTarget" name="Target capability reached">
        <bpmn:documentation>Operational capability at the target mass (50 of 500, 10%; 200 in training)</bpmn:documentation>
        <bpmn:extensionElements>
          <ac:programmeActivity kind="capabilityTarget" level="product" costRule="none" timing="engine" placement="When the operational capability reaches the target mass (not placed by the engine)"/>
        </bpmn:extensionElements>
      </bpmn:intermediateThrowEvent>
    </bpmn:subProcess>
    <bpmn:subProcess id="prog-phase-run" name="Build and run (per product)">
      <bpmn:task id="prog-build" name="Agentic build and adoption ramp">
        <bpmn:documentation>Ramp to steady state along the S-curve, milestones L1…L4.</bpmn:documentation>
        <bpmn:extensionElements>
          <ac:programmeActivity kind="build" level="product" costRule="engine" timing="build" placement="12 months after the onboarding stages (Gantt build ramp)">
            <ac:param key="setupDuration" value="12" unit="months"/>
          </ac:programmeActivity>
          <ac:raci responsible="prog-lane-orchestrator" accountable="prog-lane-designAuthority" consulted="prog-lane-agentArchitect" informed="prog-lane-finops"/>
        </bpmn:extensionElements>
        <bpmn:multiInstanceLoopCharacteristics isSequential="false">
          <bpmn:loopCardinality>3</bpmn:loopCardinality>
        </bpmn:multiInstanceLoopCharacteristics>
      </bpmn:task>
      <bpmn:task id="prog-run" name="Agentic run (steady state)">
        <bpmn:documentation>The agents deliver and support, supervised by the delivery team.</bpmn:documentation>
        <bpmn:extensionElements>
          <ac:programmeActivity kind="run" level="product" costRule="engine" timing="run" placement="From month 16.2 after the case start to the horizon"/>
          <ac:raci responsible="prog-lane-agents" accountable="prog-lane-orchestrator" informed="prog-lane-finops"/>
        </bpmn:extensionElements>
        <bpmn:multiInstanceLoopCharacteristics isSequential="false">
          <bpmn:loopCardinality>3</bpmn:loopCardinality>
        </bpmn:multiInstanceLoopCharacteristics>
      </bpmn:task>
      <bpmn:task id="prog-agentops" name="AgentOps run team">
        <bpmn:documentation>Platform floor plus an operations load per agent vFTE.</bpmn:documentation>
        <bpmn:extensionElements>
          <ac:programmeActivity kind="agentops" level="product" costRule="engine" timing="run" placement="From month 16.2 after the case start to the horizon" cost="87249.63">
            <ac:param key="runSizeMode" value="hybrid"/>
            <ac:param key="runFloorMin" value="0.5" unit="FTE"/>
            <ac:param key="runFloorPct" value="4" unit="%"/>
            <ac:param key="runOpsPerAgent" value="0.15" unit="FTE"/>
          </ac:programmeActivity>
          <ac:raci responsible="prog-lane-orchestrator" accountable="prog-lane-designAuthority" consulted="prog-lane-agentArchitect" informed="prog-lane-finops"/>
        </bpmn:extensionElements>
        <bpmn:multiInstanceLoopCharacteristics isSequential="false">
          <bpmn:loopCardinality>3</bpmn:loopCardinality>
        </bpmn:multiInstanceLoopCharacteristics>
      </bpmn:task>
      <bpmn:task id="prog-hubRun" name="Knowledge Hub run">
        <bpmn:documentation>Curation and retrieval; the infrastructure is shared by the products.</bpmn:documentation>
        <bpmn:extensionElements>
          <ac:programmeActivity kind="hubRun" level="product" costRule="resources" timing="hubRun" placement="From month 5.1 after the case start to the horizon (charged in years with agents)" cost="59826.2">
            <ac:param key="khCurationFTE" value="0.5" unit="FTE"/>
            <ac:param key="khInfraMonthly" value="1153.85" unit="€/month"/>
          </ac:programmeActivity>
          <ac:raci responsible="prog-lane-aiReviewer" accountable="prog-lane-designAuthority" informed="prog-lane-finops"/>
        </bpmn:extensionElements>
        <bpmn:multiInstanceLoopCharacteristics isSequential="false">
          <bpmn:loopCardinality>3</bpmn:loopCardinality>
        </bpmn:multiInstanceLoopCharacteristics>
      </bpmn:task>
      <bpmn:intermediateThrowEvent id="prog-govGates" name="Governance gates in place">
        <bpmn:documentation>Non-bypassable CI gates · C2 quality control · Human-in-the-Lead review · Anti-false-success guardrails · Enlarged Definition of Done · AI-BOM (AI Bill of Materials)</bpmn:documentation>
        <bpmn:extensionElements>
          <ac:programmeActivity kind="govGates" level="product" costRule="none" timing="engine" placement="Product month 5: the engine's first adoption crossing"/>
        </bpmn:extensionElements>
      </bpmn:intermediateThrowEvent>
      <bpmn:exclusiveGateway id="prog-gate-L2" name="Maturity gate L1 → L2">
        <bpmn:documentation>Team rules &amp; shared prompts in place; agents used on ≥ 1 activity; basic guardrails; positive first-value signal</bpmn:documentation>
        <bpmn:extensionElements>
          <ac:programmeActivity kind="gate-L2" level="product" costRule="none" timing="engine" placement="Product month 12: the engine's crossing of L2"/>
        </bpmn:extensionElements>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="prog-gate-L3" name="Maturity gate L2 → L3">
        <bpmn:documentation>Agent-recommendation acceptance ≥ 90%; human override 5–15%; 0 P1 incident caused by an agent; all gates green for 90 days; Design Authority approval</bpmn:documentation>
        <bpmn:extensionElements>
          <ac:programmeActivity kind="gate-L3" level="product" costRule="none" timing="engine" placement="Product month 24: the engine's crossing of L3"/>
        </bpmn:extensionElements>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="prog-gate-L4" name="Maturity gate L3 → L4">
        <bpmn:documentation>Multi-agent orchestration stable; autonomous within bounded scope; measured value at scale; AI Office + Design Authority sign-off; governance &amp; audit in place</bpmn:documentation>
        <bpmn:extensionElements>
          <ac:programmeActivity kind="gate-L4" level="product" costRule="none" timing="engine" placement="Product month 31: the engine's crossing of L4"/>
        </bpmn:extensionElements>
      </bpmn:exclusiveGateway>
    </bpmn:subProcess>
    <bpmn:subProcess id="prog-phase-assurance" name="Assurance and value">
      <bpmn:task id="prog-valueTracking" name="Value tracking">
        <bpmn:documentation>Actuals per quarter against the plan; steer when behind.</bpmn:documentation>
        <bpmn:extensionElements>
          <ac:programmeActivity kind="valueTracking" level="case" costRule="optIn" timing="case" placement="Over the horizon"/>
          <ac:raci responsible="prog-lane-finops" accountable="prog-lane-aiOffice" informed="prog-lane-designAuthority"/>
        </bpmn:extensionElements>
      </bpmn:task>
      <bpmn:task id="prog-riskAiAct" name="Risk mitigations and AI Act obligations">
        <bpmn:documentation>The mitigations of the risk register and the obligations of the AI Act tier.</bpmn:documentation>
        <bpmn:extensionElements>
          <ac:programmeActivity kind="riskAiAct" level="case" costRule="optIn" timing="case" placement="Over the horizon"/>
          <ac:raci responsible="prog-lane-aiOffice" accountable="prog-lane-aiOffice" consulted="prog-lane-designAuthority"/>
        </bpmn:extensionElements>
      </bpmn:task>
      <bpmn:task id="prog-auditInterviews" name="Audit and discovery interviews">
        <bpmn:documentation>Interviews and observations of the audit layer (§ 15).</bpmn:documentation>
        <bpmn:extensionElements>
          <ac:programmeActivity kind="auditInterviews" level="case" costRule="optIn" timing="case" placement="Over the horizon"/>
          <ac:raci responsible="prog-lane-aiReviewer" accountable="prog-lane-designAuthority"/>
        </bpmn:extensionElements>
      </bpmn:task>
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="prog-flow-1" sourceRef="prog-stage-discover" targetRef="prog-stage-calibrate"/>
    <bpmn:sequenceFlow id="prog-flow-2" sourceRef="prog-stage-calibrate" targetRef="prog-stage-validate"/>
    <bpmn:sequenceFlow id="prog-flow-3" sourceRef="prog-stage-validate" targetRef="prog-stage-pilotProve"/>
    <bpmn:sequenceFlow id="prog-flow-4" sourceRef="prog-stage-pilotProve" targetRef="prog-stage-decide"/>
    <bpmn:subProcess id="prog-wave-w1" name="Wave 1">
      <bpmn:extensionElements>
        <ac:wave code="w1" start="0" products="2"/>
      </bpmn:extensionElements>
    </bpmn:subProcess>
    <bpmn:subProcess id="prog-wave-wdr3dpo" name="Wave 2">
      <bpmn:extensionElements>
        <ac:wave code="wdr3dpo" start="6" products="1"/>
      </bpmn:extensionElements>
    </bpmn:subProcess>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="prog-Diagram">
    <bpmndi:BPMNPlane id="prog-Plane" bpmnElement="prog-Collaboration">
      <bpmndi:BPMNShape id="prog-Participant_di" bpmnElement="prog-Participant" isHorizontal="true">
        <dc:Bounds x="0" y="0" width="1836" height="1116"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="prog-lane-aiOffice_di" bpmnElement="prog-lane-aiOffice" isHorizontal="true">
        <dc:Bounds x="30" y="0" width="1806" height="124"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="prog-lane-designAuthority_di" bpmnElement="prog-lane-designAuthority" isHorizontal="true">
        <dc:Bounds x="30" y="124" width="1806" height="124"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="prog-lane-orchestrator_di" bpmnElement="prog-lane-orchestrator" isHorizontal="true">
        <dc:Bounds x="30" y="248" width="1806" height="124"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="prog-lane-aiReviewer_di" bpmnElement="prog-lane-aiReviewer" isHorizontal="true">
        <dc:Bounds x="30" y="372" width="1806" height="124"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="prog-lane-preceptor_di" bpmnElement="prog-lane-preceptor" isHorizontal="true">
        <dc:Bounds x="30" y="496" width="1806" height="124"/>
