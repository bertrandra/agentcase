{
  "name": "agentcase-app",
  "private": true,
  "version": "20.12.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "a11y": "npm run build && node ../tools/a11y.mjs",
    "ui-parity": "npm run build && node ../tools/ui-parity.mjs",
    "deps:gen": "vite-node scripts/gen-deps.ts",
    "deps:check": "vite-node scripts/gen-deps.ts --check",
    "theme:gen": "vite-node scripts/gen-theme.ts",
    "theme:check": "vite-node scripts/gen-theme.ts --check",
    "dup": "node scripts/dup.mjs",
    "test:affected": "vite-node scripts/affected-tests.ts",
    "validate:affected": "vite-node scripts/validate-affected.ts",
    "check": "npm run typecheck && npm run lint && npm run deps:check && npm run test",
    "e2e": "npm run build && node ../tools/e2e-smoke.mjs && node ../tools/perf.mjs",
    "parallel-run": "npm run build && node ../tools/parallel-run.mjs",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "chart.js": "4.4.1",
    "exceljs": "^4.4.0",
    "immer": "^10.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "axe-core": "^4.10.2",
    "eslint": "^9.12.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^4.2.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "fast-check": "^3.22.0",
    "jscpd": "^4.0.5",
    "jsdom": "^25.0.1",
    "playwright": "^1.56.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.8.1",
    "vite": "^5.4.9",
    "vite-plugin-singlefile": "^2.0.2",
    "vitest": "^2.1.3"
  }
}
